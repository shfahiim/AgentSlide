# ─── Required ────────────────────────────────────────────────────────────
GOOGLE_GENAI_API_KEY=your_api_key_here

# ─── AI Model Configuration ──────────────────────────────────────────────
# Default Gemini model to use for all generation tasks
GEMINI_MODEL=gemini-3-flash-preview

# Temperature settings (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE_INTAKE=0.3
GEMINI_TEMPERATURE_PLANNING=0.7
GEMINI_TEMPERATURE_CONTENT=0.7
GEMINI_TEMPERATURE_RESEARCH=0.3
GEMINI_TEMPERATURE_COMPRESSION=0.3

# Maximum retry attempts for failed AI calls
GEMINI_MAX_RETRIES=3

# ─── Generation Pipeline ─────────────────────────────────────────────────
# Number of slides to generate in parallel (1-5 recommended)
SLIDE_GENERATION_BATCH_SIZE=3

# ─── Development ─────────────────────────────────────────────────────────
# Enable debug mode features (raw IR viewer, step inspector)
NEXT_PUBLIC_DEBUG_MODE=false
