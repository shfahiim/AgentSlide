# ─── Required ────────────────────────────────────────────────────────────
GOOGLE_GENAI_API_KEY=your_api_key_here

# ─── AI Model Configuration ──────────────────────────────────────────────
# Default Gemini model to use for all generation tasks
GEMINI_MODEL=gemini-3-flash-preview

# Temperature settings (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE_INTAKE=0.3
GEMINI_TEMPERATURE_PLANNING=0.7
GEMINI_TEMPERATURE_CONTENT=0.7
GEMINI_TEMPERATURE_RESEARCH=0.3
GEMINI_TEMPERATURE_COMPRESSION=0.3

# Maximum retry attempts for failed AI calls
GEMINI_MAX_RETRIES=3

# ─── Image Pipeline ──────────────────────────────────────────────────────
# Image provider (Gemini image generation is disabled in codebase)
SLIDEMAKER_IMAGE_PROVIDER=unsplash

# Optional: Unsplash API access key (without it, seeded picsum fallback is used)
UNSPLASH_ACCESS_KEY=

# Legacy image-generation knobs (kept for compatibility; ignored when provider is unsplash)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_MAX_PER_DECK=3
GEMINI_IMAGE_MIN_DELAY_MS=60000
SLIDEMAKER_IMAGE_STRICT=false

# ─── Generation Pipeline ─────────────────────────────────────────────────
# Number of slides to generate in parallel (1-5 recommended)
SLIDE_GENERATION_BATCH_SIZE=3

# ─── Development ─────────────────────────────────────────────────────────
# Enable debug mode features (raw IR viewer, step inspector)
NEXT_PUBLIC_DEBUG_MODE=false
